# ==========================================
# TriageSync Environment Configuration
# ==========================================

# Backend Configuration
# Copy these variables into backend/.env

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connection_limit=10&pool_timeout=60"

# Authentication
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=24h

# Frontend Configuration
# Copy this variable into frontend/.env

VITE_API_URL=http://localhost:5000/api